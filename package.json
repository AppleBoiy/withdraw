{
  "name": "explainboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "fonts": "mkdir -p public && rm -rf public/fonts && cp -R node_modules/@excalidraw/excalidraw/dist/prod/fonts public/fonts",
    "predev": "npm run fonts",
    "prebuild": "npm run fonts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "elkjs": "^0.12.1",
    "lucide-static": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.35.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
